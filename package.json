{
	"name": "nory-bot",
	"description": "bot made for fun",
	"version": "0.1.0",
	"main": "dist/index.js",
	"license": "Apache-2.0",
	"type": "module",
	"keywords": [
		"discord",
		"bot",
		"discord.js"
	],
	"scripts": {
		"start": "bun run src/index.ts",
		"start:prod": "bun run src/index.ts",
		"dev": "bun --watch src/index.ts",
		"build": "bun build ./src/index.ts --compile --outfile ./dist/nory-bot",
		"lint": "biome lint ./src",
		"lint:fix": "biome lint --write ./src",
		"format": "biome format --write ./src",
		"check": "biome check ./src",
		"check:fix": "biome check --write ./src",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,js,json}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"dependencies": {
		"@discordjs/voice": "^0.19.0",
		"axios": "^1.13.2",
		"colors": "^1.4.0",
		"discord-image-utils": "^0.1.5",
		"discord.js": "^14.25.1",
		"dotenv": "^17.2.3",
		"mongoose": "^9.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.8",
		"@types/node": "^25.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"typescript": "^5.9.3"
	}
}
