{
	"name": "nory-bot",
	"description": "bot made for fun",
	"version": "0.1.0",
	"main": "dist/index.js",
	"license": "Apache-2.0",
	"type": "module",
	"keywords": [
		"discord",
		"bot",
		"discord.js"
	],
	"scripts": {
		"start": "bun run src/index.ts",
		"start:prod": "bun run src/index.ts",
		"dev": "bun --watch src/index.ts",
		"build": "bun build ./src/index.ts --compile --outfile ./dist/nory-bot",
		"lint": "biome lint ./src",
		"lint:fix": "biome lint --write ./src",
		"format": "biome format --write ./src",
		"check": "biome check ./src",
		"check:fix": "biome check --write ./src",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,js,json}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"dependencies": {
		"@discordjs/voice": "^0.19.2",
		"axios": "^1.18.1",
		"colors": "^1.4.0",
		"discord-image-utils": "^0.1.6",
		"discord.js": "^14.26.5",
		"dotenv": "^17.4.2",
		"mongoose": "^9.7.4",
		"winston": "^3.19.0",
		"winston-daily-rotate-file": "^5.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@types/node": "^26.1.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"typescript": "^7.0.2"
	}
}
