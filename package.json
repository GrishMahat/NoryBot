{
  "name": "nory-bot",
  "description": "bot made for fun",
  "version": "0.1.0",
  "main": "dist/index.js",
  "license": "Apache-2.0",
  "keywords": [
    "discord",
    "bot",
    "discord.js"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "start:ts": "tsx src/index.ts",
    "lint": "eslint src",
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc",
    "format": "npx prettier . --write "
  },
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "axios": "^1.8.4",
    "canvas": "3.1.0",
    "colors": "^1.4.0",
    "discord-image-utils": "^0.0.8",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "mongoose": "^8.12.2",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/node": "^22.13.13",
    "eslint": "^9.23.0",
    "globals": "^16.0.0",
    "module-alias": "^2.2.3",
    "nodemon": "^3.1.9",
    "prettier": "3.5.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "typescript-transform-paths": "^3.5.5"
  },
  "_moduleAliases": {
    "@": "dist"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild"
    ]
  }
}
