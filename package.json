{
  "name": "nory-bot",
  "description": "bot made for fun",
  "version": "0.1.0",
  "main": "dist/index.js",
  "license": "Apache-2.0",
  "keywords": [
    "discord",
    "bot",
    "discord.js"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "start:ts": "tsx src/index.ts",
    "lint": "eslint src",
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc",
    "format": "npx prettier . --write "
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "axios": "^1.12.0",
    "colors": "^1.4.0",
    "discord-image-utils": "^0.1.3",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.2",
    "mongoose": "^8.16.1",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "module-alias": "^2.2.3",
    "nodemon": "^3.1.10",
    "prettier": "3.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "typescript-transform-paths": "^3.5.5"
  },
  "_moduleAliases": {
    "@": "dist"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
