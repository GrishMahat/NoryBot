{
  "name": "nory-bot",
  "description": "bot made for fun",
  "version": "0.1.0",
  "main": "dist/index.js",
  "license": "Apache-2.0",
  "keywords": [
    "discord",
    "bot",
    "discord.js"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "start:ts": "tsx src/index.ts",
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tspc",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "check": "biome check ./src",
    "check:fix": "biome check --write ./src",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "axios": "^1.13.2",
    "colors": "^1.4.0",
    "discord-image-utils": "^0.1.4",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "mongoose": "^9.0.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.10.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "ts-patch": "^3.3.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-transform-paths": "^3.5.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
