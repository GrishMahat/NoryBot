# Bot Configuration
TOKEN=your_discord_bot_token_here                    # Discord bot token from Discord Developer Portal
NODE_ENV=development                                 # development or production
LOG_LEVEL=INFO                                        # TRACE, DEBUG, INFO, WARN, ERROR, FATAL
LOG_OUTPUT=                                           # stdout, console, or file path
MONGODB_TOKEN=mongodb+srv://username:password@cluster.mongodb.net/database    # MongoDB connection URI
ERROR_WEBHOOK=https://discord.com/api/webhooks/your_webhook_url              # Discord webhook URL for error logging
